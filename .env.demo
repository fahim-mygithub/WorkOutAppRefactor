# Loaded ONLY by `vite build --mode demo` (npm run build:demo). Turns on the
# public, loginless GitHub Pages demo: a fake "Demo Lifter" account, all state
# in-memory, zero Firebase backend calls. The normal `npm run build` does NOT
# load this file, so production/Firebase builds are unaffected.
VITE_DEMO=true
# No AI Worker in the demo: empty URL → AI off, parse uses the on-device parser.
VITE_AI_URL=
